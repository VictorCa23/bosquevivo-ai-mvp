# BosqueVivo AI MVP 1.0 local defaults.
# Copy this file to .env when you need local overrides. Do not commit real secrets.

# Backend API
BOSQUEVIVO_SERVICE_PORT=8082
BOSQUEVIVO_FLYWAY_ENABLED=true
BOSQUEVIVO_JWT_SECRET=dev-only-change-this-secret-32-bytes
BOSQUEVIVO_JWT_EXPIRATION_MINUTES=480
BOSQUEVIVO_AI_ENABLED=true
BOSQUEVIVO_AI_BASE_URL=http://localhost:8092
BOSQUEVIVO_AI_CONNECT_TIMEOUT_MS=1000
BOSQUEVIVO_AI_READ_TIMEOUT_MS=2000

# AI Service
AI_SERVICE_PORT=8092

# IAM Service
IAM_SERVICE_PORT=8089
IAM_FLYWAY_ENABLED=true
IAM_JWT_ENABLED=false
IAM_JWT_SECRET=dev-only-change-this-secret-32-bytes
IAM_JWT_EXPIRATION_MINUTES=480

# PostgreSQL
BOSQUEVIVO_DB_BIND_HOST=127.0.0.1
BOSQUEVIVO_DB_HOST=127.0.0.1
BOSQUEVIVO_DB_PORT=5435
BOSQUEVIVO_DB_NAME=bosquevivo
BOSQUEVIVO_DB_USER=postgres
BOSQUEVIVO_DB_PASSWORD=postgres

# IAM PostgreSQL
IAM_DB_BIND_HOST=127.0.0.1
IAM_DB_HOST=127.0.0.1
IAM_DB_PORT=5436
IAM_DB_NAME=iam_service
IAM_DB_USER=postgres
IAM_DB_PASSWORD=postgres

# Frontend
BOSQUEVIVO_WEB_PORT=3000
VITE_API_URL=http://localhost:8082
VITE_IAM_URL=http://localhost:8089

# Swagger UI
SWAGGER_UI_PORT=8090

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090
